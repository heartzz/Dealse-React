DATABASE_URL=postgresql://dealse_dev_app:replace_me@127.0.0.1:5432/dealse_dev?schema=public
# Optional when the development database has more than one active retailer user.
# Use its internal DealSe user UUID, never a Supabase service-role credential.
DEALSE_DEMO_RETAILER_USER_ID=
OIDC_PROVIDER_ID=supabase
# Replace <project-ref> using the URL of the existing Supabase project.
OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Retailer image uploads use this ignored development-only directory by default.
# The local adapter is refused in production.
MEDIA_STORAGE_PROVIDER=local
# MEDIA_LOCAL_DIRECTORY=C:\\path\\to\\a\\private\\dealse-media-directory

# Production requires a private Supabase Storage bucket and these API-only values.
# Never expose SUPABASE_SERVICE_ROLE_KEY to Next.js or a mobile app.
# MEDIA_STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MEDIA_BUCKET=<private-bucket-name>

# Administrator invitations use Supabase Auth Admin API from this API server only.
# Set one server-only key and allow this exact redirect URL in Supabase Auth URL Configuration.
# SUPABASE_SECRET_KEY=
# ADMIN_INVITE_REDIRECT_URL=http://localhost:3100/admin/accept-invitation
