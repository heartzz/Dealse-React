NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEALSE_API_URL=http://127.0.0.1:3001

# Optional Playwright-only credentials. Keep actual values in ignored
# apps/web/.env.test.local. These variables are loaded by the Playwright runner
# and explicitly blanked from its API and Next.js webServer child processes.
DEALSE_E2E_CUSTOMER_EMAIL=
DEALSE_E2E_CUSTOMER_PASSWORD=
DEALSE_E2E_CUSTOMER_B_EMAIL=
DEALSE_E2E_CUSTOMER_B_PASSWORD=
DEALSE_E2E_RETAILER_EMAIL=
DEALSE_E2E_RETAILER_PASSWORD=
DEALSE_E2E_RETAILER_B_EMAIL=
DEALSE_E2E_RETAILER_B_PASSWORD=
